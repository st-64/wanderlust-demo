<% layout("/layouts/boilerplate") %>

<div class="mt-4 mb-5">
  <div
    class="card border-0 shadow-sm rounded-4 mx-auto"
    style="max-width: 480px"
  >
    <div class="card-body p-4 p-sm-5">
      <h2 class="fw-bold text-center mb-4">Join Wanderlust</h2>

      <form method="POST" action="/signup" novalidate class="needs-validation">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="mb-3">
          <label for="fullName" class="form-label fw-semibold fs-7">Name <span class="text-muted">(optional)</span></label>
          <input
            id="fullName"
            name="user[fullName]"
            placeholder="How should we display your name?"
            type="text"
            maxlength="80"
            class="form-control auth-input py-2 px-3 rounded-3"
            autocomplete="name"
          />
        </div>
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold fs-7"
            >Username</label
          >
          <input
            id="username"
            name="user[username]"
            placeholder="Choose a username"
            type="text"
            class="form-control auth-input py-2 px-3 rounded-3"
            autocomplete="username"
            required
          />
          <div class="valid-feedback">Looks good!</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label fw-semibold fs-7">Email</label>
          <input
            id="email"
            name="user[email]"
            placeholder="Enter your email"
            type="email"
            class="form-control auth-input py-2 px-3 rounded-3"
            autocomplete="email"
            required
          />
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-semibold fs-7"
            >Password</label
          >
          <input
            id="password"
            name="user[password]"
            placeholder="Create a password"
            type="password"
            class="form-control auth-input py-2 px-3 rounded-3"
            autocomplete="new-password"
            required
          />
        </div>

        <button
          class="btn add-btn text-white w-100 rounded-pill py-2 fw-bold fs-6 mb-3"
        >
          Sign up
        </button>

        <div class="text-center mt-3">
          <span class="text-muted fs-7">Already have an account?</span>
          <a
            href="/login"
            class="text-dark fw-bold text-decoration-none fs-7 ms-1 hover-underline"
            >Log in</a
          >
        </div>
      </form>
    </div>
  </div>
</div>

<% layout("/layouts/boilerplate") %>

<main class="my-4 my-md-5">
  <section class="card border-0 shadow-sm rounded-4 mx-auto text-center" style="max-width: 560px;">
    <div class="card-body p-4 p-sm-5">
      <i class="fa-regular fa-compass text-danger fs-1 mb-3" aria-hidden="true"></i>
      <h1 class="h3 fw-bold mb-3">We couldn't load this page</h1>
      <p class="text-muted mb-4" role="status"><%= message %></p>
      <a class="btn btn-dark rounded-pill px-4 py-2" href="/listings">Explore listings</a>
    </div>
  </section>
</main>

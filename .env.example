# Runtime
NODE_ENV=development
PORT=8080

# Required for local and hosted database access
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust
SESSION_SECRET=

# Cloudinary image storage (required for listing/profile uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUDINARY_FOLDER=wanderlust_DEV

# Mapbox geocoding and map rendering
MAP_TOKEN=

# Deployment proxy and browser security
TRUST_PROXY=false
CSP_MODE=report-only

# Optional Razorpay test-mode credentials (leave all three empty to disable payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Development-only seed owner; never use in production
SEED_OWNER_ID=

# Optional IP rate-limit tuning (milliseconds and request counts)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_BOOKING_MAX=10
RATE_LIMIT_PAYMENT_ORDER_MAX=10
RATE_LIMIT_PAYMENT_VERIFY_MAX=30
RATE_LIMIT_MUTATION_MAX=120
